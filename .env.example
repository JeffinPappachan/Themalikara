# --- Supabase (Themalikkara project) ---
# Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://hjwtpzxjkxqgmritrlai.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server / MCP / scripts only — NEVER add VITE_ or commit real values to git
SUPABASE_PROJECT_REF=hjwtpzxjkxqgmritrlai
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: Supabase personal access token (CI / headless MCP). Cursor IDE uses OAuth instead.
SUPABASE_ACCESS_TOKEN=

# --- Admin (used when Supabase Auth is not set up yet) ---
VITE_ADMIN_USERNAME=admin
VITE_ADMIN_PASSWORD=change-me-before-deploy

# --- Admin via Supabase Auth (recommended when database is live) ---
# Create a user in Supabase → Authentication, then sign in at /admin with email + password.
# No extra env vars required beyond VITE_SUPABASE_* above.
