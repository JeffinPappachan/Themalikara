# --- Supabase ---
# Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Local / MCP / scripts only — NEVER prefix with VITE_ or commit real values
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: Supabase personal access token (CI / headless MCP). Cursor IDE uses OAuth instead.
SUPABASE_ACCESS_TOKEN=

# --- Admin fallback (only when Supabase Auth is not used) ---
VITE_ADMIN_USERNAME=admin
VITE_ADMIN_PASSWORD=change-me-before-deploy

# --- Admin via Supabase Auth (recommended) ---
# Create a user in Supabase → Authentication, then sign in at /admin with email + password.
